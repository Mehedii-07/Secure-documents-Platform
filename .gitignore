# ============================================================
# AI-Powered Secure Document & Compliance Platform
# .gitignore — NEVER commit secrets or generated artifacts
# ============================================================

# --- Secrets & Environment ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg
lib/
lib64/
MANIFEST
*.manifest
*.spec

# Virtual environments
.venv/
venv/
ENV/
env/
.env/

# pytest
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
nosetests.xml
test-output/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ruff
.ruff_cache/

# Alembic (do NOT ignore migration scripts — they are source code)
# backend/alembic/versions/  <-- keep this committed

# ============================================================
# Node / Frontend
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnp
.pnp.js

# Vite / React build output
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local

# TypeScript build artifacts (composite mode emits these)
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# ============================================================
# Docker
# ============================================================
# Don't ignore docker-compose files — they're config
# Ignore local override secrets
docker-compose.local.yml

# ============================================================
# Editors & IDEs
# ============================================================
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================================
# OS
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ============================================================
# Logs
# ============================================================
logs/
*.log
celery*.pid

# ============================================================
# Uploads / local storage (dev artefacts)
# ============================================================
backend/uploads/
backend/storage/local/
