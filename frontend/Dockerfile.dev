# ============================================================
# frontend/Dockerfile.dev
# Development-only: Vite dev server with hot module replacement
# Used by docker-compose.override.yml
# ============================================================

FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --frozen-lockfile --quiet

# Source is mounted as a volume (see docker-compose.override.yml)
# so we don't COPY here

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
