# ============================================================
# AI-Powered Secure Document & Compliance Platform
# Environment Configuration Template
#
# COPY THIS FILE TO .env AND FILL IN REAL VALUES.
# NEVER COMMIT .env TO VERSION CONTROL.
# ============================================================

# ---- Application ----
APP_ENV=development
APP_NAME="AI Document & Compliance Platform"
APP_VERSION=0.1.0
DEBUG=true

# ---- Backend API ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database (PostgreSQL + pgvector) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=compliance_platform
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Constructed automatically by Settings; shown here for reference:
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ---- Celery ----
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- JWT / Security ----
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_VERY_LONG_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- AI Provider (abstracted — swap without changing business logic) ----
# Supported values: openai | anthropic | azure_openai | ollama
AI_PROVIDER=openai
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Only needed if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Only needed if AI_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Only needed if AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- Vector Search ----
VECTOR_DIMENSION=1536

# ---- Document Storage ----
# Supported values: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/local
# Only needed if STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT_URL=

# ---- File Upload Limits ----
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt,png,jpg,jpeg

# ---- Email (for notifications — not required for Issue #1) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME="Compliance Platform"

# ---- MFA (not required for Issue #1) ----
MFA_ISSUER="Compliance Platform"

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="AI Document & Compliance Platform"
